rupdate # Repository update
nvim ~/.config/home-manager/home.nix # Use to add packages
home-manager switch --impure --flake "$HOME/.config#default" # Activate Home Manager
cd "$HOME/.config" && nix flake update nixpkgs home-manager # Update locked Nix inputs
nix profile install --inputs-from "$HOME/.config" nixpkgs#hello # Install a package in this container
nix profile list # List packages in the user profile
nix profile remove hello # Remove an interactively installed package
nix shell --inputs-from "$HOME/.config" nixpkgs#hello # Open a temporary shell with a package
nix shell --inputs-from "$HOME/.config" nixpkgs#hello -c hello # Run one temporary command
nvm alias default 20.16.0
export CC=clag
nvm install -s 20.16.0
nvm use 20.16.0
gupdate # Git update
fed # Fuzzy edit
lf # File manager
fs-copy # Filesystem copy
fs-paste # Filesystem paste
gclone # Clone repository
fadd # Fuzzy git add
fco # Fuzzy check out
gwc # Git worktree checkout
fwc # Fuzzy worktree checkout
clone-bare
cheat # Get help for a command
emoji # Get an emoji. Try alsoe: ctrl-o i
wcurl # Download files with curl
